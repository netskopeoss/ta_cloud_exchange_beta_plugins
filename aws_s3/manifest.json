{
    "name": "AWS S3 WebTx",
    "id": "aws_s3",
    "version": "1.3.0-beta",
    "module": "CLS",
    "minimum_version": "6.1.0",
    "mapping": null,
    "netskope": false,
    "types": [
        "webtx"
    ],
    "format_options": [
        {
            "label": "JSON",
            "value": "json"
        }
    ],
    "description": "This plugin supports ingestion of WebTx data to an AWS S3 bucket. This plugin supports ingestion in JSON format only.",
    "configuration": [
        {
            "label": "Authentication Method",
            "key": "authentication_method",
            "type": "choice",
            "choices": [
                {
                    "key": "Deployed on AWS",
                    "value": "deployed_on_aws"
                },
                {
                    "key": "AWS IAM Roles Anywhere",
                    "value": "aws_iam_roles_anywhere"
                }
            ],
            "default": "deployed_on_aws",
            "has_api_call": true,
            "payload_fields": [
                "authentication_method"
            ],
            "mandatory": true,
            "description": "Select the method to be used for AWS client authentication."
        }
    ]
}
